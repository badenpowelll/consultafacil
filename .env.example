# Copie para .env.local e preencha. Nunca faça commit de .env*.
NODE_ENV=development

# Conexão da aplicação: papel cf_app (sem BYPASSRLS, dono de nada).
DATABASE_URL=postgres://cf_app:TROQUE@localhost:5432/consultafacil
# Conexão administrativa: só para migrações e seed, nunca na aplicação.
DATABASE_URL_ADMIN=postgres://postgres:TROQUE@localhost:5432/consultafacil
# Senha do papel cf_app (mínimo 24 caracteres), aplicada por npm run db:app-password.
CF_APP_DB_PASSWORD=

# Chaves de dados AES-256-GCM versionadas: "1:<base64 de 32 bytes>,2:<...>"
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CF_CHAVES_DADOS=
CF_CHAVE_DADOS_ATIVA=1
# Chave do índice cego (HMAC), diferente das chaves de dados.
CF_CHAVE_INDICE=

CF_DOMINIO_BASE=localhost
# Em produção: "producao". Garante cookie __Host- Secure mesmo se o domínio estiver errado.
CF_AMBIENTE=desenvolvimento
CF_SESSAO_OCIOSA_MIN=30
CF_SESSAO_ABSOLUTA_H=12

# Só para npm run db:seed (dados fictícios; recusa rodar em produção).
CF_SEED_SENHA=

# E-mails (worker de notificações: npm run worker). Em desenvolvimento, "memoria" não envia nada.
CF_EMAIL_TRANSPORTE=memoria
# Para enviar de verdade: CF_EMAIL_TRANSPORTE=resend, com a chave e um remetente de domínio verificado.
RESEND_API_KEY=
CF_EMAIL_REMETENTE="Consulta Fácil <avisos@seu-dominio.gov.br>"
